{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0439::Text::1", "source_sha256": "fb567628b59a6fc6fb0d7c1d27cd3814d99cb22dd788e347356ace10d16cd771", "target": "Kalmak ve sohbet etmek isterdim ama gitmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0440::Text::1", "source_sha256": "021ca2be34a6f755929b36dddf284180a89116dab30ee8a5d4080024f26502a4", "target": "Zag, şu anda ilgilenmem gereken o kadar çok ölümlü var ki..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0441::Text::1", "source_sha256": "e952b75497aab4f316828fbccd546f08699d05c8489564412987295fd594f408", "target": "Yakında dışarıda görüşürüz, tamam mı?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0442::Text::1", "source_sha256": "4e16a32ec1d2265364ccef90bdf1e4a72f75310af9dbda2d50466b3a33b8302a", "target": "Dışarıda çok oyalanırsan seni bulmaya gelirim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0443::Text::1", "source_sha256": "ac8938385f9a608acf809c5aa4d0ac035e63ba1295aa23968c9cc00e2557d8a0", "target": "Anlaşılan son zamanlarda ikimiz de epey meşgulüz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0444::Text::1", "source_sha256": "9125424b9ee6ae7bfc0c0a076d13c8ab74dd72c3764b689c64ab511a7629c53e", "target": "Sen de geldiğine göre sonunda gidebilirim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0445::Text::1", "source_sha256": "ee7251018585e7e2df00acfaa7ad65eba6b364d3b0e1813b7e7f674dc2b337dc", "target": "Sohbete başka bir zaman devam etmemiz gerekecek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0446::Text::1", "source_sha256": "aa123ae28eb7ff4dc82c437e951f4a3ea72c5476a6ab496c9454c533842e810f", "target": "Kusura bakma, Zag, şimdi bir sürü ölümlüyü almaya gitmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0447::Text::1", "source_sha256": "663ca9bf7f5794d9a51826199f2e3be7fce09c5f4af80c8452d15c89357c155d", "target": "Müsaade et, Zag. Az önce haber geldi, yine yukarıda bana ihtiyaç var."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0448::Text::1", "source_sha256": "3b968c0e42538c472906510efae28d8652db51b734dbc0514cc7a7e635c99bf7", "target": "Umarım baban bütün bunlara itiraz etmez."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0449::Text::1", "source_sha256": "7e7f2d7e156b91dfb05c6a0f4d9653257428253a1242ab3cf4ea4a185f17d976", "target": "Geçen sefer o sefillere günlerini gösterdik, değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0450::Text::1", "source_sha256": "c23a575a821128b7e1ef84d288521e11c9552b895641cec3ad4e7c59fe527ff0", "target": "Dışarıda sana rastlamak güzeldi. Çıkmayı başarmana da sevindim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0451::Text::1", "source_sha256": "ac9d44a8a6d5fabf472f2375614a8a1508ee1fd34ac24822499b4007cd8cc44b", "target": "Yine sonuna kadar gitmişsin. Etkileyici."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0452::Text::1", "source_sha256": "4f595bf56314b41336701091e4bdc28e2541ee52de1a6d45c7694f2d53044980", "target": "Dışarıda sana destek olma fırsatı bulmak güzeldi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0453::Text::1", "source_sha256": "41d789571499e0175bb6a9774bc4614bdd3ffa2706dde2a9d8a7834eb585c4f6", "target": "Geçen sefer dışarıda iyi iş çıkardığını duydum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0454::Text::1", "source_sha256": "b4deba0d229a48a9ae7a02b417450b2003a48e2c44e2d011509a6ba21ea402eb", "target": "Ruhlar son başarıların hakkında fısıldaşıyor, Zag."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0455::Text::1", "source_sha256": "b2912abd798008f71ca44e3a94093528a466571d928dfb0eb2500ee5b0cd61bb", "target": "Şu anda burada sohbet edecek pek vaktim yok, Zag."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0456::Text::1", "source_sha256": "948b682e078325c7ecefe755bf4ed376e8110619d71e7a9976a681bf843dadd7", "target": "Çok acelen yok, değil mi, Zag?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0457::Text::1", "source_sha256": "bbc5f94f6fb8a984c471718f9006c57fd0bfbe471935788b5d10230e3bfc4799", "target": "Eh... yukarıdaki bir ölümlü uzun, güzel bir ömür sürmüş."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0458::Text::1", "source_sha256": "910be180c0559e14e026dbec4b1455749210a7b614fb35fff4928844edd2bd51", "target": "Yanımda biri varken kısa mesafeye ışınlanmayı denesem, ne dersin?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0459::Text::1", "source_sha256": "1ee6274483244474e6641092298957a334e1bdc6aa5902cc664cbd2157e917f1", "target": "Eh... bence deneme başarılı oldu. Sence de öyle değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0460::Text::1", "source_sha256": "eae5d608b28f48b6f0d3960fb6015d4ebc2cb05f4ff5dc4621aab82e340c4d6b", "target": "Buradan ışınlanıp gitmem gerek; bana katılmak istersen..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0461::Text::1", "source_sha256": "37c1005b641fd05384adb9f953384e455e08fe53d1093a06bd41d1b998f1397a", "target": "Keşke seni doğrudan yüzeye ışınlayabilsem. Gerçi bu da fena değildi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0462::Text::1", "source_sha256": "d132640bdfa374e8d38e7e0b59ebfaa83dcfdef979d69d815d4e17e1ef10ec76", "target": "Biraz buradan uzaklaşalım, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0463::Text::1", "source_sha256": "ab1d976e50e270dfbd5c1497b77a514f7fbe9d2ff9d9b3209499fc9e95d4b89f", "target": "Oh. Mola için teşekkürler. Sanırım artık işe dönme vakti."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0464::Text::1", "source_sha256": "de2b8eeebf5f364231cca7494723065d4db5ce07ca3be2e97974a71e728d14c4", "target": "Tam da mola verecektim. Bana katılmak istersen..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0465::Text::1", "source_sha256": "a8936f00c840509a390aa4d9a3e4d38cb19a32421850529159971bff73711fe0", "target": "Sohbet etmek güzeldi. Kendine dikkat et, Zag."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0466::Text::1", "source_sha256": "db122a1881582314561ba395cce9780c6953ecb2036219ee5009f6a8bbfbdbd8", "target": "Bence odana dönsen iyi olacak, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0467::Text::1", "source_sha256": "bcb81083a465d5407103231989266a208bf6876a1ab72284843a68905bdf26cc", "target": "Mm. Şimdilik görevlerime dönsem iyi olacak."}
