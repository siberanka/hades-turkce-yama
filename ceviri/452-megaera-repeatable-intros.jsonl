{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0055::Text::1", "source_sha256": "174e9600bbb88de18dde7e9c934d0715f4df53f6f4bf1083e0c2f933c7c22d22", "target": "Keşke böyle olmak zorunda olmasaydı."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0056::Text::1", "source_sha256": "72263cba555d5824adece09aa9917da8b0f5ad4ecbcb8316a3d56ca2d9c068fb", "target": "Neden hep dövüşmek zorundayız."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0057::Text::1", "source_sha256": "d63388e872b58174447f3fb5bd30977ab6a9104d440bfe8cd0550503f5e8b074", "target": "Şu küçük kavgalarımızdan birinin daha vakti geldi."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0058::Text::1", "source_sha256": "db6f67ad5d02c255e67444ad90173e3888187abcca07de41b04c2024959bc340", "target": "Tam da şimdi gelmeni umuyordum."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0059::Text::1", "source_sha256": "0038c6a0ec302015cde4ac0d2a46d9c896211a38edf3231838fc0538f96c627f", "target": "Madem geldin, küçük bir dansa ne dersin?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0060::Text::1", "source_sha256": "9ee6a3ee4e08a9688aa1ec4f83f8cf3d01b4dc8597e498cd8022f0687f83ad9a", "target": "Eski günlerin hatırına bir daha kapışmaya ne dersin?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0061::Text::1", "source_sha256": "189fabf07cfe844d182c88642362095a9f6d6312522c8d4d49a8a9cf9078a039", "target": "Bana hazır mısın, Zagreus?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0062::Text::1", "source_sha256": "8ee6d18b347d0fb60fa6f1ca00dd34553151b68ef43f31cd57507fa10c41815f", "target": "Ben de tam ne zaman geleceğini merak ediyordum."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0063::Text::1", "source_sha256": "6caedae57c8a3915ea6c73eb9da3c4a515334ad5afeb9f799491ed950bf840b5", "target": "Sonunda geldi, Prens’in ta kendisi."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0042::Text::1", "source_sha256": "f27d075ce21dd9b644c5d3ea560d946e57a9275b298ab9cf48b5c47c43552e5d", "target": "Yine elimde can vermeye mi geldin?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0043::Text::1", "source_sha256": "bce64da7f7d2eda7068177405c451df25e8ca9c40faa0f1d6acf7adcd9fe4af0", "target": "Geçen sefer seni öldürdüm, yine öldüreceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0044::Text::1", "source_sha256": "80a0390b50413d6cfa8d403004010730ce757b638540b5dbf5bce5fb2680fff6", "target": "Yine ölmek istiyorsun galiba?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0045::Text::1", "source_sha256": "7e53dd21835a253ef49a75fa347047fc84e40122f182b9c54855aa129efca35d", "target": "Daha dersini almamışsın anlaşılan."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0046::Text::1", "source_sha256": "0a6bfce807b16858792fccc32b5c5738e485630dee551c1a8a1a48c070d4dc1d", "target": "Umarım bu sefer bana biraz daha dişli bir rakip olursun."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0194::Text::1", "source_sha256": "30297847f4f4c4778a7e5dd9721b1463512b86d8a2c2799b90b04420a3b5a6d0", "target": "Ders almıyorsun anlaşılan. O zaman gel de öl."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0195::Text::1", "source_sha256": "9946a2074d8d6d0c6a05417e317bee04f33aaee3c3505c3c1496d4631fd81dcf", "target": "Beni geçemeyeceksin, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0048::Text::1", "source_sha256": "d1ca8cca723f72136ef543ec0af89d317ef0c554de1382d9cff8cd0729de8716", "target": "Asla kenara çekilip sana yol vermeyeceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0049::Text::1", "source_sha256": "8d4b4470a42bb42e16096781f41bddc143f7ca1a0489a1f176aa91b1a05dd0db", "target": "Yine döndüm. Dönmeye de devam edeceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0050::Text::1", "source_sha256": "b7da1f1930e86575e9da19fe3210f45f40c25b62ea1b9228501ebac503cf8832", "target": "Beni ancak cesedimi çiğneyerek geçersin."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0051::Text::1", "source_sha256": "2dd0a07b0677aa02da7d4907b0cc5beaf2571013ffc167a726012ad6ab0710f8", "target": "Karşında asla geri adım atmayacağım."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0053::Text::1", "source_sha256": "499465c9c05c3b1aa76d9f46da27474ce452b79b994ef89885b2b87fdc2a75aa", "target": "Nasıl sonuçlanacağını biliyoruz galiba."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0054::Text::1", "source_sha256": "ff872b1d449a3a6aaf12b74a9d023dffdfc81a6728213c3d55f48632ba56f1f2", "target": "Sana karşı durmaya yeminliyim, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0206::Text::1", "source_sha256": "7920be17db73dcdc983e8655c4c4cfc885345d1599fea2bc97967afda3d44a68", "target": "Ben de senin gibi dönmeye devam edeceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0207::Text::1", "source_sha256": "a13b9f171daec2367c359e9ea1a55613225dccac606ab50356e71f4db862b23b", "target": "Kenara çekilip sana yol vermeyeceğim, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0208::Text::1", "source_sha256": "b564ae989215675b6f61f1a4ef7350f2ce0fc02994c6cdecd48d55a9ccc71016", "target": "Artık seni durdurabilir miyim bilmiyorum ama yavaşlatabilirim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0209::Text::1", "source_sha256": "5f6a3446ec08c29c39d02bbfdbab8e0779269cbec0a49fbb19f197e63aa3de9c", "target": "Geçen sefer yaptıklarını ödeteceğim sana."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0742::Text::1", "source_sha256": "60f4fa1f84f28bb747392f7eaf3678940a03347d4365c61116677396eb777473", "target": "Bir gün bu karşılaşmalardan birinde gardını düşüreceksin, ben de eski günlerin hatırına seni yine öldüreceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0743::Text::1", "source_sha256": "133e477e4b35004f198a1a7fc4c897bb55087f5a1b9f83db502136df2887fb62", "target": "Seni durduramasam da... birkaç sağlam darbe indirebilirim, bundan eminim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0744::Text::1", "source_sha256": "4440291af2548720b414ff0cb19c14d65115ad09d0c75c7ffcfe3fd3611b5823", "target": "Burada ödetecek çok hesabım var, haberin olsun, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0745::Text::1", "source_sha256": "98aa0719ea7152510b9ff6cffa4c932a4b3061d507ac31d9591a0a833296d016", "target": "{#DialogueItalicFormat}Ihh{#PreviousFormat}, burada beni kaç kez üst üste yendiğini neredeyse sayamaz oldum, Zag..."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0032::Text::1", "source_sha256": "824efe6cf9088024bff66c4131d12bbff7d6fb56fa0b370a6b0485afdc42d0d9", "target": "Belki gelirsin diyordum."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0033::Text::1", "source_sha256": "8c98fbd80ad578a9486a0795fe1e9536c3bacbdca2552a61d7cba4809b29f2db", "target": "Tam vaktinde geldin."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0034::Text::1", "source_sha256": "35bb87ea10187fecd17f8ac01c82561004e879da1811fdde762d682a84987475", "target": "Havadan sudan konuşmaya gerek yok, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0035::Text::1", "source_sha256": "4fa8ae2e4c05054e3cf093f290a9a65ec1d3a83742326393c2878f38bef3b31c", "target": "Yine dövüşmeye heveslisin anlaşılan?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0036::Text::1", "source_sha256": "e8394c56b2f96d0bc1e14af76ce6e638b60b00afce2d9c4f7dd31b5952e7e696", "target": "Başlayalım mı artık."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0037::Text::1", "source_sha256": "189fabf07cfe844d182c88642362095a9f6d6312522c8d4d49a8a9cf9078a039", "target": "Bana hazır mısın, Zagreus?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0038::Text::1", "source_sha256": "e6a4ec4d957c97ea330fb814e55d357d2706cae25168787a6e792d18a0ddfa7f", "target": "Hadi, neler yapabildiğini göster."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0039::Text::1", "source_sha256": "780806d9944044442edc513f4cc7f48356f60b8305aab4e4ab02efae746e5c2a", "target": "O zaman başlayalım, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0040::Text::1", "source_sha256": "e4e395c11b875171bb4da818bcd658c71cc2656bfadc02efe6170b2a8a196886", "target": "Sana hazırım, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0041::Text::1", "source_sha256": "d52c5b12eadca3bdc851b2b40eef08aa3c85ae2aa2e5b27bf06342da3265a4d6", "target": "Bir adım daha atma, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0052::Text::1", "source_sha256": "4ebeca9426b60c8b8e86ee33556d1b2b1b1cadf76eef3cad995839dd7503de9a", "target": "Dövüşmeden öylece salıveremem seni."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0047::Text::1", "source_sha256": "4d7d8c899e61b09e397d2693fa792e2198150b7a8f223bfb658696c74ba0bdac", "target": "Yine sensin demek."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0190::Text::1", "source_sha256": "804fe82e71558eac0fee76f0a43b2b1d6518e8d8d832810a4dcad08c74a58e64", "target": "Sırf beni görmek için yine onca yolu gelmişsin."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0191::Text::1", "source_sha256": "ae022b052d7c08a3ba9b2987433f6722f6ec446f412197059161c53653b0e797", "target": "Gardını al, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0192::Text::1", "source_sha256": "c205a0a05db5f0b47339fcc20399afea3d0c81c21d1d5c29054333359dd33ebb", "target": "Bazen tam zamanında geliyorsun, hakkını yemeyeyim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0193::Text::1", "source_sha256": "98c636b9c2c537110a97aeb7ae419764dc6c90c937cc6298cda6424ccee5e15a", "target": "Dur, Zagreus. Bir adım daha atma."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0526::Text::1", "source_sha256": "2ef0c4db202d108cc46610ec7176fe339fe5a2e7817cb2c29ef4a5963f44276b", "target": "Benimle bir tur daha kapışmaya mı geldin, Zagreus?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0527::Text::1", "source_sha256": "d6d47b6167a52cb8027d1732acc8a631a4af57776b670ec33d18c9233af02fc6", "target": "Bakalım beni geçebilecek misin, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0528::Text::1", "source_sha256": "d354172abffbdec07c5ef91dab6aec3e4190234a85a200fcad5b8cd0a959185e", "target": "Darılmak yok, Zagreus. Sakın kendini tutmaya kalkma."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0529::Text::1", "source_sha256": "27dfb75047127ab24d7b94df399b17bb8df48ee41f087a4fb8fca769beeb7712", "target": "Sende sevdiğim bir şeyi söyleyeyim mi, Zag? Hep tam zamanında geliyorsun."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0530::Text::1", "source_sha256": "028659834f6cf4c1b590d4c6a196dc5b807ab27b6fb8ab6f2004950076f0fd3c", "target": "Umarım bu sefer bana hazırsındır, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0531::Text::1", "source_sha256": "c6169025ba2ad4ae00a86a0160778d94583ea55a0355b36d39e193d916670ac9", "target": "Sana insaf edeceğimi sanma, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0532::Text::1", "source_sha256": "b35be0b89f788d77c52da6a6e4cfed0c604c8edad9a6d1cd8f78e2c66b603d44", "target": "Burada aramızdakinin sadece iş olduğunu biliyorsun, değil mi, Zag?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0533::Text::1", "source_sha256": "be893ec12c10d35d140d2851d1c7d29b93329206525974be59157dd0af5c2dae", "target": "Elinden gelenin en iyisini bekliyorum senden, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0534::Text::1", "source_sha256": "c1f87e9442bdb53d481a186f0c42360bf4f06884c277a4c9bd8ebf97949ddb67", "target": "Bana insaf etmeyi aklından bile geçirirsen seni öldürürüm, Zagreus."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0535::Text::1", "source_sha256": "5797efa2d1ff8579da9ebc80e6e96f4f5c535ad2d696c6f339e90de3e2494ce1", "target": "Bana karşı kendini tutmak yok, Zagreus. Hele burada hiç."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0536::Text::1", "source_sha256": "6bf087970afe2b09fb9767ba2bfc5b5e72dd6939ceb6e9dc4d6a9118960f259a", "target": "Seninle böyle karşılaşmaktan bıkmadığımı göreceksin, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0537::Text::1", "source_sha256": "0ee7d6fe3a40290091f665e43904e1de8f49e7bd54bc94a58bdeae8e048c209c", "target": "Dövüşmeden öylece çekip gitmene izin veremeyeceğimi biliyorsun."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0538::Text::1", "source_sha256": "7de785ac96dfbe63356bacbc8e9bb30e95bcec1d2bf485fccc2c4b015d1c948e", "target": "Dans etmeden buradan çıkamazsın."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0539::Text::1", "source_sha256": "353675f1befbf1b63dd6c49e8c187f48204cfcb0a5572ad04d0131756836283b", "target": "Canımı yakamazsın, Zag. Ama denemeni görmek isterim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0540::Text::1", "source_sha256": "d5c0e979e2691e1dffd504f98a4eb6ee438372eacacb4f317df738d9edda6feb", "target": "Şu küçük buluşmalarımız hoşuma gitmeye başladı, Zag."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0541::Text::1", "source_sha256": "08213e85edebb53a7d3a41df0938570b815a4acff68cbc0b647c05af83664783", "target": "Hadi, Zag. Bütün gücünle saldır bana."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0542::Text::1", "source_sha256": "7c38a5a249c7dbc02a21ffe7976ebe630de253450ce7903edf7edfa1e79a2237", "target": "Beni mi istiyorsun, Zagreus? Gel de al o zaman."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0543::Text::1", "source_sha256": "7324664b94d555898aa08a8893e7fb37426a771cd3e71c1a16658950151344c0", "target": "Hakkını vermem gerek, Zag. Beni hiç uzun süre bekletmiyorsun."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0544::Text::1", "source_sha256": "46d48a5517cfa4a62892eaae91f52063b42eb36e5d1a1e0c2e2656a8e5080713", "target": "Gayet iyi görünüyorsun, Zag. Bakalım ben ne yapabileceğim."}
{"key": "Content/Scripts/EnemyData.lua::/VO/MegaeraField_0545::Text::1", "source_sha256": "b4127bb79022ea54520bf52fb3a43c7a8836dd215b4f9a00f9207ff4f59dca2e", "target": "Acı olmadan zevk de olmaz, değil mi, Zagreus?"}
