{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0002::Text::1", "source_sha256": "ecc48f3c7cbb8969b7eb8332ab68ffa13dec4407488ddaecccfc95a6a8fc61b0", "target": "Seni sapasağlam görmek güzel, Prens Z.!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0003::Text::1", "source_sha256": "328b7315d2d1c12ef81eb677bf5692c2f15486b02535d236d110abc68adae42d", "target": "Hayat iyi gidiyor galiba, Prens?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0004::Text::1", "source_sha256": "64c68aa232739a79cd9e936b7fd7262ea9d3aabc1d40b55e910c91b3b26c5406", "target": "İdare ediyorum, sorduğun için sağ ol, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0005::Text::1", "source_sha256": "3ba85fbce61c245406452cbca4ab2aa7ca9458e3be40a07dd1caea0b5c268d5f", "target": "Buradan çıkacaksın, hiç şüphem yok!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0006::Text::1", "source_sha256": "c2123db1a027fa0eafbc479636c6df515dd05fa87dc2e48fa1ef270a09d41648", "target": "Kısa da olsa uğraman iyi oldu!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0007::Text::1", "source_sha256": "764beb249ad3b9e38c889a3292f472842fa0bdad2c89b5110bba7be416601a71", "target": "Seni görmek iyi geliyor, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0008::Text::1", "source_sha256": "499649443adb46cca231618fb3af86e990e8cccd39deb6405ef5eac648210be1", "target": "Dışarıda dikkatli ol, olur mu, Prens?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0009::Text::1", "source_sha256": "e2a123ef951ee0db22f957e2d15b3ae0d4286c8ecf5c6bfe46729a2fbd45dc64", "target": "Benim için de canlarına oku, tamam mı, Prens Z.?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0010::Text::1", "source_sha256": "8d597cf71b2de381ab9118a10e7214f176466f990f83bf8865770044b92c7fd0", "target": "Git, benim için de haklarından gel, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0011::Text::1", "source_sha256": "16a8a72b1f90e57038ec760959d39493387adaff17699541f0be65954f8580d1", "target": "Tam sana göre bir şeyim var, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0012::Text::1", "source_sha256": "2f55d2256bfce1f9644643d412c2ed2fc37a385c02f716ed2dd3d415b55bcf79", "target": "Seni görmek hep güzel, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0013::Text::1", "source_sha256": "b084119054ceff4cc48b547cdba4ebfd18cf5eb90feb66d1c2d62ba62d38ab99", "target": "Moralini bozma, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0014::Text::1", "source_sha256": "359be40919a93d6d1dff7378ba5544053e73b38c5e6c7fca2ab1f6c12dd47ac5", "target": "Mücadeleye devam, Prens!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0015::Text::1", "source_sha256": "2cd747d313d503606ee161a1cbfe9b8afd0effbac21d2b9bacae4801a6a1860e", "target": "Kendine dikkat et, tamam mı, Prens?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0016::Text::1", "source_sha256": "de8674b0d395ec01624fda38c6c7090bfc3c688530d109606ce72eb2283426e7", "target": "İkimiz de devam edelim, anlaştık mı?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0017::Text::1", "source_sha256": "e5b724e6e075cbb53b3ad1d4252ba9a2ec4bad377ea162caaf341674b80d60f2", "target": "Beni böyle ziyaret ettiğin için sağ ol!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0018::Text::1", "source_sha256": "974812ef57a430af6fe3dd007e75705fd9847d39bbd9efce64b4d5ddff0dddf8", "target": "Umarım son zamanlarda her şey yolundadır."}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0019::Text::1", "source_sha256": "c9d8299d6122d8f381403aa44eeda00efde4e65add3781b1d3b334fd72908adc", "target": "Dışarıda adımlarına dikkat et, tamam mı, Prens Z.?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0020::Text::1", "source_sha256": "67f7d2485c283bc55b4dc1ea097753c561a97376dbca9d09d989a2cbc1615324", "target": "Merhaba, Majesteleri! İyi görünüyorsun!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0021::Text::1", "source_sha256": "8db506017b8098e886b27f6154987dfd895d19ab99f3a7cd00b422bb9857f712", "target": "Merhaba, Majesteleri! Nasıl gidiyor, her şey nasıl?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0022::Text::1", "source_sha256": "64c11a20cb810faa7b5afd74f53f157ca13c89e5a7222d5e2beb755d0be51b0a", "target": "Dost yüzü görmek güzel doğrusu!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0023::Text::1", "source_sha256": "629dd71f70e08a799a9a512a92a5363240b45db37f86e27bfaa844e469feb44a", "target": "Seni görmek hep bir zevk, Majesteleri. Dışarıda kendine dikkat et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Sisyphus_0024::Text::1", "source_sha256": "30a45592bba6b3b5e17fbb4c71a82229230f5b2eae6e840e9da6578d88960140", "target": "Yeraltı’ndaki en iyi dostum da geldi! Nasıl gidiyor, Prens?"}
