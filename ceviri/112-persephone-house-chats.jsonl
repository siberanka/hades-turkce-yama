{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0162::Text::1", "source_sha256": "b7ec6c9334573c9c8309da9495c5489b52b8d047b001467dd7fc8e28f8551b5b", "target": "Kusura bakma, Zagreus, şimdi yetişmem gereken önemli işler var."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0163::Text::1", "source_sha256": "16531940a08087515faabf19804e66d04547767e621ba3222a79cf7ccb71c0e7", "target": "Yardım edebileceğim bir şey varsa bana söyle, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0164::Text::1", "source_sha256": "f534927129ede8f6921274653d492b46959d94eff02cedbf6e4def7faafb393f", "target": "Baban seninle sandığından daha çok gurur duyuyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0165::Text::1", "source_sha256": "08ae232a584fd80b78e17b7f07407b9bbf9a41db15a6f2da06078325c582d4c3", "target": "Git, bizi gururlandır, oğlum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0166::Text::1", "source_sha256": "ef4bc460630a594359f1b4493cd7f2bb368e091e8a66e4f497a971a1a6806b37", "target": "Her zamanki gibi diyarın güvenliğini sağlıyorsun, değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0167::Text::1", "source_sha256": "3886a51faad1c54cc6faa9ebd4dff0c8c1d8571bfc1ed48a239a51de55947c66", "target": "Seninle sohbet etmek her zaman güzel."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0168::Text::1", "source_sha256": "deeb8aea4a5bc084114947c1da191a0364613aaece58286584b78eec0ae3ec8d", "target": "Bence Konak son zamanlarda gayet düzenli."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0169::Text::1", "source_sha256": "eb9b915beae19aad393511e15eef2628206376c83b20d0dc69116f00759eee05", "target": "Umarım son görevin iyi sonuçlanmıştır."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0170::Text::1", "source_sha256": "430e9a58f21ad3b86e8ba78661e9651f31f71e47b3a4931d45866b50e734cef6", "target": "Ara sıra kendine dinlenecek zaman ayır!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0171::Text::1", "source_sha256": "1a0e82b4c0311a14c609db2bec33d7c561634c0198f48b31db943436e5d210ee", "target": "Bir annenin sahip olabileceği en iyi oğul olduğunu sana hiç söyledim mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0172::Text::1", "source_sha256": "456a363129006af11330ef9e31b42b391c1132dbf01ee7fc0670816c7980c6b4", "target": "Umarım kıyıdaki küçük kır evim sapasağlamdır!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0173::Text::1", "source_sha256": "b10a4e836879000917d2fc52fa9603fa598c269abbcb08b4bf5f34268fa40cff", "target": "Fırsat bulursan yüzeydeki bahçeme göz kulak ol lütfen."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0174::Text::1", "source_sha256": "7ba3b9fa828c779ef9a3ab8a99163e29a12affa515cfed3655544f258c2edf2f", "target": "Bu bahçe şimdilik gayet iyi gidiyor bence."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0175::Text::1", "source_sha256": "be0b961714b0b10f4191bd65775d34da421af3a10371a5c30a2ff6b5c141a8ad", "target": "Babanın seni fazla üzmesine izin verme, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0176::Text::1", "source_sha256": "2e18d8e2ceeb31cce0ae6bad54ee89ad79ffb9dfa61748791b6f4ca17b0a791b", "target": "Her zamanki gibi iyi görünüyorsun, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0177::Text::1", "source_sha256": "5d79509b714e84f1cdebdd3b982d624dccaf2204db235a1ea4a44970c27a28a7", "target": "İlk fırsatta babana kimin sözünün geçtiğini göster, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0178::Text::1", "source_sha256": "94317f2dcabb6655b92179fee6dce905666a7c6e92a443cdcd036ee4c7258d3a", "target": "Nar ağaçları hâlâ güzel güzel gelişiyor. Dayanıklı emektarlar."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0179::Text::1", "source_sha256": "d7fa468932e0d6bdc1d3722b970d4d0cec080bb12a31131e9abb1b8309425759", "target": "Senin için yapabileceğim bir şey varsa bana söylersin, değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0210::Text::1", "source_sha256": "0715c5caafb880fb91518dee146b76f089a8d4f46ad5697cd3d0365cbfa22387", "target": "Babanla beni şimdilik mazur gör, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0211::Text::1", "source_sha256": "b3906deff962f16ad2ad4d1adc861349d0649abf8c6bb22e27eda23e40cb020a", "target": "Haydi, Hades. Bir kez olsun ona güzel bir şey söylemeyi dene."}
{"key": "Content/Subtitles/en/Hades.csv::Hades_1127::Line::1", "source_sha256": "ceae5177a49b10dccbfb1e98d9f8282c5010affbc0e8ef4c74abd35d2f5c89f9", "target": "Hırr...."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0212::Text::1", "source_sha256": "2fe57cf75da84ff00af9f5c7801435abbf8bef7ed43a0dbbb10f442563be3f86", "target": "Babanla burada bitirmemiz gereken biraz daha iş var."}
{"key": "Content/Subtitles/en/Hades.csv::Hades_0169::Line::1", "source_sha256": "f3c093c166d451bbdbe09c96841e9991d4e39241aa4f8c0b33551c37b0dbf6b7", "target": "Öyle."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0213::Text::1", "source_sha256": "16fe2ec84fdba013d350e766bf02bf24ea63a370ffffc9d8ee9965d6c98058f1", "target": "İşler hiç bitmiyor, Zagreus!"}
{"key": "Content/Subtitles/en/Hades.csv::Hades_0079::Line::1", "source_sha256": "7955bb0508f6bd23b22b12f04a72e3b2ec911dbf6b6d9916450d661cb0146fda", "target": "<Küçümseyerek homurdanır>"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0214::Text::1", "source_sha256": "1161a47c8f05f1aca3bff959deebe875e311826d331f3dfabef5acb23084e26d", "target": "Herkese fazlasıyla yetecek kadar evrak işi var!"}
{"key": "Content/Subtitles/en/Hades.csv::Hades_0085::Line::1", "source_sha256": "607aa5dd167731b5466465a52aad6b284acbad69d8def31d882cc4e7d31d7481", "target": "Iııhh..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0215::Text::1", "source_sha256": "5b70390b47e8c5d46b671b799533eaf74bcffbaafca6cb1cec11185537db612d", "target": "Uğraşacak bol bol evrak işi var, inan bana Zagreus!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0216::Text::1", "source_sha256": "d8bed4766e73972c1457fd05a38e63d381eeb4d88c3d6fcdecdf9a1d0f0804b5", "target": "Dışarıda birbirinize fazla yüklenmeyin, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0217::Text::1", "source_sha256": "8276dbf84143b0d69958aad6f52a443e3f1e472008b5945e0fdd1020159e6de1", "target": "Son zamanlarda dışarıda çok iyi iş çıkardığını duydum, Zagreus."}
{"key": "Content/Subtitles/en/Nyx.csv::Nyx_0462::Line::1", "source_sha256": "10f04cf67c96e87531f4eb3f52711564ad916bb6d33d443d50c42894f1851f41", "target": "<Hafifçe gülümser>"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0218::Text::1", "source_sha256": "4450723d98407f1b3eee6120110dc1cf849b2764512c19f82621e1caa9170890", "target": "Ah, beraber yeni karanlık planlar kurmakla meşgulüz, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0219::Text::1", "source_sha256": "5700d88a7f87b1166d0b947b2b5b19ddb1b921e3fd5698870dc06b8e11d7040c", "target": "Nyx’in annelik konusunda ne çok tavsiyesi varmış!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0220::Text::1", "source_sha256": "b50ec1628a833d477460615eee8347ae0dbe19ce9de05ed1c564b88a7c17d244", "target": "Nyx bana ilk günlerin hakkında biraz daha anlatıyordu, oğlum."}
{"key": "Content/Subtitles/en/Nyx.csv::Nyx_0052::Line::1", "source_sha256": "7f2302c86d005fed4397eef4134c2c03eb6324268449f5cf97595e6307942c31", "target": "Hım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Persephone_0221::Text::1", "source_sha256": "b52746c9720e660ab4d3a7f76f67b3a105dde9b4949eaa8ebabaf4ab0a3f72c6", "target": "Görünüşe göre Nyx’i kendine biraz zaman ayırmaya yine ikna edemedim!"}
