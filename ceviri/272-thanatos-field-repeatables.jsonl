{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0380::Text::1", "source_sha256": "2bfa64a89157c3b742b9a957b1187309497eb79a9eb3d99c9fa005fb3422c052", "target": "Güzel, yetişmişim. Olabildiğince çabuk geldim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0377::Text::1", "source_sha256": "853841989493f0f446905d434ed45c7750967bebeb0b65e6ceb61df47cc684e5", "target": "Yardıma ihtiyacın olduğu haberi geldi. Öyle mi, Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0355::Text::1", "source_sha256": "fb1e1be070bb5b9950e43a7cc67637408e4e0b7a99c92a254a686387658eab10", "target": "Bunu Konak’ta kimseye anlatmak yok, anladın mı, Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0356::Text::1", "source_sha256": "634d300e72e2dd6fa86a228c82d128c1bf2f929fe13f5e151e06159f0b891b01", "target": "Yine başını belaya soktuğunu duydum. Ortalığı toparlamak gerekiyormuş."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0357::Text::1", "source_sha256": "fa08e04b02e69d7cbccc191bf20fda4d185f3be606c4dfd18d99da6f78c44648", "target": "Sonra sohbet ederiz. Şimdi şu sefilleri halledip bitirelim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0358::Text::1", "source_sha256": "640a3aa44a6d74fb448509f6350190b1b10556858aada889b7c705f49c26802c", "target": "Araya girmemin sakıncası yoktur umarım, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0359::Text::1", "source_sha256": "cbed24bd4a2d864bbb3c274e1ea9256c1f9f9a65e2c6ec6819a3550dffbf6f9e", "target": "Eskisi gibi buradaki işi birlikte halledelim mi, Zag?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0360::Text::1", "source_sha256": "aa74c548910fc8178a3863dae628db9c2526a2399626fb3664ce8a054bcd2789", "target": "Fazla kalamam; şu işi bitirelim mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0361::Text::1", "source_sha256": "79a5e343b721aae11ee8f315d74ef0e9191a302f18520712b859d1ec68f7c4a4", "target": "Küçük yarışlarımızdan birini yine yapmak istersin diye düşündüm. Hadi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0362::Text::1", "source_sha256": "f1b1d3b275a81c312c73c2c5b7d1700637b7e46dacbde6ddc69cd3be9aebfd98", "target": "Birlikte ölüm saçmaya ne dersin, Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0363::Text::1", "source_sha256": "c389f488ddfdc11ae36abec95804dd59bbb7d4baed06b1d9b08944193942df14", "target": "Pek vaktim yok ama bakalım biraz yardımcı olabilir miyim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0364::Text::1", "source_sha256": "763ed27a417625af299e9f650f57e1103a14b094f7235121108234fe91c3a7d3", "target": "Unutma, kimseye tek kelime etmeyeceksin. Hadi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0231::Text::1", "source_sha256": "d8b0096c8b6baa9e2efc5fa0a88e2879898c2b63d6c66455bf568a3245edd118", "target": "Yardıma ihtiyacın var gibi görünüyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0236::Text::1", "source_sha256": "d76843d8dfa3ab353f8a2da674130356ca49e96863a9371965617ebb31e0bc50", "target": "Bakalım bu işte kim daha iyi, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0379::Text::1", "source_sha256": "bbb442e2dff18c13689b5de7408885ff3c3accb4536d170cc051a3f5a64a1acb", "target": "Burada biraz desteğe ihtiyacın var gibi geldi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0665::Text::1", "source_sha256": "217e9fc914ed250d45c9219a7b63f735f9061e8dc4d17ced59ec616a85d1216f", "target": "Şu işi bitirelim."}
