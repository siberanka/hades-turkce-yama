{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0136::Text::1", "source_sha256": "ed5bca2b54b06e9a4c09788a2347eed77c520fa2ace0327c9b7f024a0bfa0936", "target": "Artık burada istenmiyorsun."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0137::Text::1", "source_sha256": "60790900975afd5afc8ac6bf1b94c2b09913b235da997676c78ef840691772ff", "target": "Konuşmak istediğim izlenimini nasıl vermiş olabilirim ki?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0138::Text::1", "source_sha256": "1dd058b6f795cd539c0757f65bef67a953b5504e281d2046c6a468c30be684b3", "target": "Mülküme ne kadar zarar verdiğinin farkında mısın?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0139::Text::1", "source_sha256": "f83924efabe3a31fd898c12e083a98674761ba26f90d45defafbb6f563f0a4f7", "target": "İstediğin kadar başarısız ol. Buradan asla çıkamayacaksın."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0140::Text::1", "source_sha256": "ea6c88bf609fbdedcd27626a7f4c958453b54c2112f6719c9a824e1b38433271", "target": "Haddini öğreneceksin; belli ki zor yoldan."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0141::Text::1", "source_sha256": "fd9089188347d1bdad9345db43bfeb256afa747eb07d751aab37dcc60a33558f", "target": "Kendi ailem tarafından böyle aşağılanmak..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0142::Text::1", "source_sha256": "ee6017ff67d8cbe2f12b402c28747a62a24edb0ae8ed304accaa818bd7af8397", "target": "Senin şu akılsızlığını anlamakta zorlanıyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0143::Text::1", "source_sha256": "b7ce1a7788147cffceebd897eef6be2667318aa46dc2f099a1d2904c8b4e4909", "target": "Artık aramızda konuşacak bir şey kalmadı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0425::Text::1", "source_sha256": "b15609276e73c79be277ffcbcfff1cc7d980fdbd54bbff472ddc2fb2f6827723", "target": "Buradan asla çıkamayacağını söylemiş miydim?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0426::Text::1", "source_sha256": "527b7cc4630b61aa3c4ef8006db7470307cfdc64a0f8ef4f12d895275d033ec7", "target": "Buradasın ve burada kalacaksın, evlat. Hepimiz gibi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0427::Text::1", "source_sha256": "f99b71b728929ac1f150903e02cf9a7e73c200deefc3e60c52e506963e68881f", "target": "Açıkça gördüğün gibi şu an meşgulüm."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0964::Text::1", "source_sha256": "16cad973ffbdba52f00d220184d7ca296c3482ae391a1e7a910a2113b87b421d", "target": "Lanet evrak işleri, bir türlü bitmiyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0965::Text::1", "source_sha256": "0d02b1ab6c71c21460e8bffc6651ca6f64b3e0e39d2b8b2f97de7965e2bc59f3", "target": "Son zamanlardaki çabalarının buraya faydası dokundu."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0966::Text::1", "source_sha256": "ad95315ae7b86efa9fb144dcb63bbfd293c6353095ebf6d6372df1ea0546ee4f", "target": "Git de dışarıdaki o sefilleri biraz korkut, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0967::Text::1", "source_sha256": "ec9ecd8af4c736ca8ba64bc4b7f60b1c7378b0cca4d824f73378bcc7f309069c", "target": "Yine döndü, Cerberus! Bir dahaki sefere onu bu kadar uzun oyalamamaya çalışacağım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0968::Text::1", "source_sha256": "0d9b6eece74bc0bfbf9b90688f718b12a4c1a7bb1947345f071c6c215ba6459d", "target": "Bir dahaki sefere bunun acısını çıkaracağım, hiç kuşkun olmasın."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0969::Text::1", "source_sha256": "8c03c543f82e584c276f8e3ca0c6c5f50113b7ddb968a47100eec1edd1dd10e9", "target": "Oraya bir dahaki gidişinde yeni bir Satir istilasına karşı gözünü açık tut..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0970::Text::1", "source_sha256": "779bac32892e58144383117d395b672942152d95b7d4ae582ea9ae617f8fc586", "target": "Annene de mutlaka selam ver!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0971::Text::1", "source_sha256": "0fbdd4c166f1169c21e9752b610b71ef142fd48e05f4e760cff22969883e9872", "target": "Yol açtığın onca yıkımın ardından onarıma başlandı bile."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0972::Text::1", "source_sha256": "a30427afd3cc1909e73f384b844d672eaf632a57915fea7c0d0c660e7c924fb0", "target": "Seni burada tutmak için daha ne yapabiliriz acaba..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0973::Text::1", "source_sha256": "a919891792a55cd1653cf6b2ede74fb6a40fb077c250e84b628da9fb947068ec", "target": "Gördüğün gibi birikmiş işlerimi halletmem gerekiyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0974::Text::1", "source_sha256": "294d70233ae60615618533f1d903f4b0ede38960f194d38f6d9ca630f0e3b0fb", "target": "Ah, artık mahkemeyi yeniden toplamamız gerek sanırım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0975::Text::1", "source_sha256": "62bfc876e10ab5954c3821e1e6c5a5fbd78efba07f053a25b20afaf3cedb2ae0", "target": "Gördüğün gibi bütün bu evrak işleriyle ilgilenmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0976::Text::1", "source_sha256": "1f01c2bf0191b896540030ff52aa6c65b12bd2881281e7d5037e2168078937ba", "target": "Şunu söylemeliyim: O sefer Theseus’u tam bir maskaraya çevirdin."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0977::Text::1", "source_sha256": "7d9333aeed2c06f58a72c43d730363915ccb44b7bfe1f3b276e7e62629118628", "target": "Asphodel’deki güvenlik önlemlerimiz belli ki yetersiz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0978::Text::1", "source_sha256": "78c70256eaf8ae1ed5491215411ef9aa63f6d932fc06d594838dab45ef98f4c1", "target": "İhtiyacın varsa git dinlen. Ama sen hazır olduğunda Yeraltı da hazır olacak."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0979::Text::1", "source_sha256": "75d415150b7e7b891f3f03a9191d424f78d345c40d622e359b7e0a56185482aa", "target": "Doğru bulmasam da bu sefer sana biraz daha yumuşak davrandım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0980::Text::1", "source_sha256": "9cd284f58f6f76b998c1d2a05749078c8c8b6457814795622f3895ee6ab1d1dc", "target": "Kısacık hâl hatır faslımız da böylece başlayıp bitti."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0981::Text::1", "source_sha256": "9521fab913f88064665d5d56be8a52399fd674672c68a3d216d0ae120ecbd5e5", "target": "Görevlerini şimdiye kadar olduğu gibi yerine getirmeye devam et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0982::Text::1", "source_sha256": "efc9caa71dade4c4cadc54ff5033ab04a80330807e091e2db330134d2005b292", "target": "Cerberus dönüşünü bekliyordu."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0983::Text::1", "source_sha256": "b0e2f6f16ebc664dd599632e30805bed21ecc96f814466ab37a0171b5ddb78fd", "target": "Annen bu son başarını bekliyordu."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0984::Text::1", "source_sha256": "6e106b38f8bf6d1e9f5889170ed71d09c5c90621e266790303a109a5ee542bfc", "target": "Sohbete ayıracak vaktim varmış gibi mi görünüyorum, evlat?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0985::Text::1", "source_sha256": "f39aa91e5df70c36a3b476cbb324ef1edeaeff5a29ea2eba52d65325b1a86948", "target": "Görevini nasıl yerine getirdiğini başka zaman konuşalım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0986::Text::1", "source_sha256": "f5fbcddcdceef582baf7e1abe5b171cf43e47efb14e114405f72deab4f749b19", "target": "Elysium’daki kötü şöhretin daha da büyüdü."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0987::Text::1", "source_sha256": "ce4014733592ab1d4bb6c2b999317782f19535e4d57e5e22dcd55d5270c012b9", "target": "Kabul etmeliyim... orada iyi iş çıkardın."}
