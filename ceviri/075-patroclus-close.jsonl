{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0315::Text::1", "source_sha256": "719f8a4c617edcb3698705e9f70eff730ffe0c3975a6a953c8a23197c2438192", "target": "Seni yeniden görmek güzel, yabancı. Al bakalım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0316::Text::1", "source_sha256": "7011397b0d6875e487e290e6e690418bdb0b2a4741da0f1bd34222933756ef58", "target": "Biz iyiyiz. Umarım sen de iyisindir."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0317::Text::1", "source_sha256": "8ca352759d5981d06b5c8d3e886774e6162cf330e13adaac6fc9cc4756dc8364", "target": "Seni görünce artık seviniyorum, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0318::Text::1", "source_sha256": "a9f288163ffb7d5e067beffbf99d3ee36e47cdabdbd3dbf660ce93e2ca2c9825", "target": "Önündeki savaşlarda galip gel, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0319::Text::1", "source_sha256": "a7b40103f65eafaa3ade2dc72516fa654a74dda49f780992f8a6aae26ec61088", "target": "Ne zaman geleceğini merak ediyorduk, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0320::Text::1", "source_sha256": "355ea9b246de9256fe61640499963d8f7051c1c3b18157388cddcd7530fb2097", "target": "Achilles’le vakit geçiriyorduk, o kadar."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0321::Text::1", "source_sha256": "7cf9d3c8b41f41327c6ef43a1d1568ef39ce6452ab6697b15c12028b7ca47c13", "target": "Burada Achilles’le birbirimize anlatacak daha çok şeyimiz var."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0322::Text::1", "source_sha256": "e0ec9adc7a29b03c43b46bd1e2a2d3b94a488455d8a2fa259df8558a99c863e5", "target": "Buradaki dostumun eskiden dövüştüğü gibi dövüş, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0323::Text::1", "source_sha256": "b974063cd9b3c5455e7bddfbed6d4cfc4026a3ad8394aef2411cc6ac2877c9b4", "target": "Umarım o kapıdan geçince bütün korkuların arkanda kalır."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0324::Text::1", "source_sha256": "b6322720cae49857b6ff209c3e9059389b48ac8d1abdd14412ce1e306e1352b8", "target": "Bizim şampiyona gününü göstereceksin, değil mi, yabancı?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0325::Text::1", "source_sha256": "11393cb005cffaf3c2854cfbff1bdbffa28162b38b1816c977d841a42c2e8749", "target": "Biraz olsun yardım edebiliyorsam memnunum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0326::Text::1", "source_sha256": "2fd239d24a835ffd24a559b4d9f1979507f2c2133f5f0275191628cdb7bd94eb", "target": "Önce Achilles geldi, şimdi de sen."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0327::Text::1", "source_sha256": "b36a0bf52d97cbfb8e1105291ecde3d075fda9731083ee92cb1aee802c13aee7", "target": "Küçük açıklığımızda istediğin kadar kal lütfen."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0328::Text::1", "source_sha256": "3d0292dd465387d64a016df6ee691158872ae4aeff22ef308e9eccfae8119352", "target": "Buralardaki savaş düşkünü silah arkadaşlarımıza dikkat et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0329::Text::1", "source_sha256": "f449b19b965f2ecb5eb9353e1535b14e0f94d705ab8b7be14d097c1216d92415", "target": "Böyle bir yerde kendini evinde hissedebiliyorsan rahatına bak, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0330::Text::1", "source_sha256": "dbbd2be3b03f311930891a1ab64611be3aba29df6b227041ea025a362551f4c9", "target": "Bu dövüş ıvır zıvırından yine var. İstersen birini al, yabancı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0331::Text::1", "source_sha256": "9901e83d4a64bfae49be9fc7145846ff4543a70e9e293d86fa39c69cf090f871", "target": "Son zamanlarda bütün Elysium seni konuşuyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0332::Text::1", "source_sha256": "59d94c0694f572a65be65ac0b2cdec9a1059a2a4b3610e3fa822ede82cb00757", "target": "Bizim sözde şampiyon buralarda artık eskisi kadar sevilmiyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0419::Text::1", "source_sha256": "171b2dfa71c92decca3bb81656e319df12ed21f7bb8b01854eecc30521b47767", "target": "Yaptığın her şey için minnettarım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0420::Text::1", "source_sha256": "ebc4f2d92125965ccaef6a79727878d026ce6651a34171deca1edf23948a97d7", "target": "Onca sabrın ve iyiliğin için."}
{"key": "Content/Scripts/NPCData.lua::/VO/Patroclus_0421::Text::1", "source_sha256": "67244d640509899a1837635be9fb111d1ecc95e25dc2fe73d053bc8795d1c48f", "target": "Bunu almanı istiyorum."}
