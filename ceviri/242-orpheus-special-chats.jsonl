{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0116::Text::1", "source_sha256": "238e9d273771235efc7566e6d2c3bf04509fc3b515a9ad918ed9743cf935611b", "target": "Umarım bütün bunlardan yara almadan çıkarsın, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0117::Text::1", "source_sha256": "b10156d14a9ba3529001e1fed114aa31be21915a152786a4309d6fbd0dcb617d", "target": "Yeraltı’ndaki bitmek bilmez uğraşın iyi gidiyordur, değil mi, dostum?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0118::Text::1", "source_sha256": "e6140e30b3f5f0ab3431ce632b9584ef15fba27fd74eeab1bd3969b49d1d0c5f", "target": "Bir sonraki kaçış denemen iyi geçecek gibi geliyor, dostum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0119::Text::1", "source_sha256": "942e98b6e9d7a6eb8b4a0b0bd80f4b76585338d06b9f838cb8b16bc0be8c5a47", "target": "Umarım ilham perini oralarda bir yerde bulursun, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0120::Text::1", "source_sha256": "713d37c7521facac428db7f5b0e56b917f85813b0c626235468eaf23db79528f", "target": "Her başarısızlık kendini değerlendirmek için yeni fırsatlar getirir, değil mi, dostum?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0121::Text::1", "source_sha256": "322c61d78f977d6d21d9d0b4f4f148490e092bf4479d39ded9493f5b46d49f9b", "target": "O inanılmaz başarılarının hepsini bana anlatmayı ihmal etme, lütfen, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0122::Text::1", "source_sha256": "43ccf5103d7c3c0b011af748a5a594bb403f25f43d220ed5e3152402be957260", "target": "Şöyle kısacık konuşmak bile moralimi düzeltiyor, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0123::Text::1", "source_sha256": "1f7d109ad755e4bced08e9abd46afd187335b89bb7f3e28ffec3412b0dfbf8e1", "target": "Dilerim Kaderler benimkileri yıktıkları gibi senin de bütün hayallerini yıkmaz!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0101::Text::1", "source_sha256": "076f2054b2eda479d451df73a6036778d6b703e9b006ca817bb0ac6c67700179", "target": "Belki fark etmişsindir, dostum, şu an konser veriyorum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0102::Text::1", "source_sha256": "bc40b6b83d191796551a15e26e7d9448891eb86e2d9985e459f72fdc9dcfa012", "target": "Kusura bakma, Zagreus, ama şu an şarkımı söylüyorum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0103::Text::1", "source_sha256": "ec6eefb21b47f2d77412b62d1ed8fca25f168b6c11fd5f5fcd49b6993c87a22c", "target": "Seni şarkıyla övmeye öyle dalmışım ki, Zagreus!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0104::Text::1", "source_sha256": "2965cb740b98b55ac9fb8364553b224ad6b76ce2fe7e103d759836e60e9e0836", "target": "Bu ilahi, kahramanlıklarına adanmıştır, dostum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0105::Text::1", "source_sha256": "38c22e3aabca3ca6fafa444737e189b9ac3055c5df720092c7f64e4152ca8a27", "target": "Şu an konuşamam, dostum; şarkı söylemeliyim!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0106::Text::1", "source_sha256": "02379c77aad0287d62b25d39b2630bd21ff336aaf873e8b6666bcef3dd3d449b", "target": "Müziğim bu kasvetli günlerimize biraz ferahlık getiriyordur, değil mi, dostum?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0107::Text::1", "source_sha256": "195c17eb887dea9c3e374ec5d0bd8efed8196c2be6635d1c25994c522ea8a148", "target": "Doğumunun hikâyesi öyle karmaşık ki, dostum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0108::Text::1", "source_sha256": "19062e80236b61d9118e0ec00e513692c0c9e8a06de12622d6e8ec2ca41a2e6e", "target": "Lütfen alkışlamak için sonunu bekle!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0109::Text::1", "source_sha256": "a363f3eac751d3c4458a4d3fd469275460f8137a33871ffb188c76905db3f563", "target": "Dionysus Efendi’yle aranda böyle bir bağ olması ne şaşırtıcı!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0110::Text::1", "source_sha256": "c063b92c6077127c2c3b3ad167ca343bb4daca995482e3b38959049b4507a667", "target": "Dilerim şarkılarım ününü her yere duyurur, dostum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0111::Text::1", "source_sha256": "0ab94c2f440a13d3aebf2a240bbefcff23ce4d0c1782373c2a4a97d535a31a51", "target": "Soyun artık sır olarak kalmak zorunda değil, Zagreus!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0112::Text::1", "source_sha256": "96cec1b9aa1aa6060e84b2302df3d70aef08b9d44f11d6628e14b45959e4f930", "target": "Seni öven şarkılarımı her yerde söylemeye devam edeceğim!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0113::Text::1", "source_sha256": "0dbca33db513b8507e3b65dc5a14da06df1cab013c0e12f6f69dbf683218c58d", "target": "Bana şarkı söylemek için ilham verdin, dostum!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0114::Text::1", "source_sha256": "d552658e6361663566fbda7cbeef60deaebb2bb52c403bb778c7ff6d11b64569", "target": "Şarkıma odaklanmalıyım, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0115::Text::1", "source_sha256": "004be1d6cf0358a9dbd809a38aea21c8afdcea4cf143ddf118cb8fb9d3f8ba42", "target": "İlahim günlerinde, ya da gecelerinde, sana biraz teselli veriyordur, değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0204::Text::1", "source_sha256": "dfa39eb5169211c09e18c627e6524d442b650086864b4d5944a9a9a33a9e1a01", "target": "Umarım günün, ya da gecen, benimki kadar güzel geçiyordur, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0205::Text::1", "source_sha256": "96d2a53f98bdec9d111d43d14d09bc18c95212c6aa9545f1fb1009b6e884efe4", "target": "Dilerim Kaderler benimkiler gibi senin de hayallerini gerçekleştirir!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0206::Text::1", "source_sha256": "14cf9c14b7e00497dc76fd690e6a634018b81655124d15c94a75f646fb396a2e", "target": "Ah, Zagreus, seni yeniden görmek ne güzel!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0207::Text::1", "source_sha256": "52df4a4f6c9c7c4793c7482c025db5534a234d530b27023c818ee1be2c45182b", "target": "Tam da seni düşünüyordum, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0208::Text::1", "source_sha256": "e5b262c7ccb5bfa3a9eb96cb7425fff13842848c5558c023d501b36da46e1782", "target": "En sevgili dostuma selam olsun."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0199::Text::1", "source_sha256": "86a35ec946565cdec9b7608494f5650f589c4be1e55dbf6f23943248260ab754", "target": "İlham perim harikulade şarkılar yazıyor, sence de öyle değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0200::Text::1", "source_sha256": "cacd10e02e475f76126bd91cb3a99f84b4d41380808695188b7d6b7f74281234", "target": "{#DialogueItalicFormat}Ah{#PreviousFormat}, bu bana Eurydice’mi öyle hatırlatıyor ki..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0201::Text::1", "source_sha256": "ed804144309bf3cc6fc64dae92651fd41a466a6c71e55191443693a102eed8b2", "target": "Keşke şimdi onunla birlikte olsaydım..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0202::Text::1", "source_sha256": "449c65c2d520b9c4d979101c45b957d6412b4a26f0375318cf1b70d2116f2538", "target": "Eurydice’min şarkılarının eşi yok..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0203::Text::1", "source_sha256": "caac9a830db80bb00b3867ad888560d478c9c71a712d375cb1f04b5c6d032862", "target": "Bu en sevdiğim şarkılardan biri. Belki senin de öyledir?"}
