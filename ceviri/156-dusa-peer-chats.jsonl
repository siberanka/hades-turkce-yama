{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0516::Text::1", "source_sha256": "147dda37ae9a1f57e7eb1389233843d16d53f1082e89c84e11a0cf228c2a2d2d", "target": "Al bakalım, Cerbi! Şey, beni yeme, lütfen?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0517::Text::1", "source_sha256": "ba9a67e1beb0b439bf5ddcb116049b2c72524a236bd94c791be9163617a4e516", "target": "{#DialogueItalicFormat}Şey{#PreviousFormat}, al bakalım oğlum! Üç porsiyon, tam sevdiğin gibi!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0518::Text::1", "source_sha256": "2376f173217d95f739caa60bdc07fe1f54750c15d6f9b6c096cb6b4d3f2bb75d", "target": "...Bu kez hepsini yedikten sonra nereye gittiğine dikkat et lütfen, olur mu Cerbi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0519::Text::1", "source_sha256": "28724730c9d6f2c5be975dd8d2abd1599677482eb0b73672030ea0ad869614cf", "target": "{#DialogueItalicFormat}Ah{#PreviousFormat}, hadi Cerbi, çabuk ye! Bu kadar kötü olamaz! Yani... olabilir mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0383::Text::1", "source_sha256": "be54f11f7fc799cabc32539de555bbbd593dfafab0190e69884689cbf71df69a", "target": "Şimdi olmaz, Zag. Özel görüşme."}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0491::Text::1", "source_sha256": "367e7c3c26eb03313806a719ffbd76e2d8c88959755e42aaf460529df714ca19", "target": "Kendinizi fazla yormayın, olur mu Prensim?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0492::Text::1", "source_sha256": "d971dae7dde6904a7d6478bfdacece9b58a621a3bebca2a60be92197d9454698", "target": "Lütfen mola vermeyi unutmayın, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0384::Text::1", "source_sha256": "2d058cfa5b519c01ad870fa98a3b1889d43061a5013f6bd48cedb5d8e9ceb6ba", "target": "Başka zaman konuşmamız gerekecek, Zag."}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0495::Text::1", "source_sha256": "6c8c9355676ef375d68ad3b5a486be8a0bd040132ff7b24ac2553a28540b8f27", "target": "Benim için ara sıra dinlenin, olur mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0497::Text::1", "source_sha256": "4d2469965b0adb4f9db50a16873622990035f48b82a85629c597a5f4e5b75952", "target": "Umarım bir dahaki sefere dışarıda Meg Hanım’ı görürsünüz!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Dusa_0498::Text::1", "source_sha256": "3f98ebec6b3ad5e77ce655f8bb079a7eac62c0f443223695b032f46cd7d727b9", "target": "Umarım yakında Thanatos’la tekrar görüşürsünüz!"}
