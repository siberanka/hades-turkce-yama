{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0003::Text::1", "source_sha256": "864e6482dc8dd9ebcd738cf4cd11f22777418af5839b44ff94315201b0c52eed", "target": "Karanlık sana yol göstersin, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0376::Text::1", "source_sha256": "6c2713402bdd2440b7d00e0e28f4a31496f787f1f60d8c2a6d0c318b4056355c", "target": "Aklım başka yerde, lütfen kusuruma bakma, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0004::Text::1", "source_sha256": "cafa0fac8c2b5382f0cecd3b114553118b81a58314083294fba594a9a748ceb5", "target": "Kendine iyi bak, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0005::Text::1", "source_sha256": "025b8884f3879d6dd34c923018c9b2d2eee58911f0e5212ec0333587870bd600", "target": "Seni de Konağımızı da gözeteceğim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0006::Text::1", "source_sha256": "6355007f2f388a5bfb383c798efb70a6c24ac9196dfb80c2a577bb259e4964b2", "target": "Baban için kaygılanma. Gözüm onun üzerinde olacak."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0007::Text::1", "source_sha256": "948154a6cd511e72b7b9aa4c9992027ab3deb3ebe583e98366898aa04d827958", "target": "Cerberus için endişelenme. Sen yokken ona iyi bakılıyor, karnı da doyuruluyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0008::Text::1", "source_sha256": "792c29376e0f427e0b0c562734c0dbb904c8aac5fa809579f2c0da0d9d89c0ad", "target": "Git, amacına ulaş, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0009::Text::1", "source_sha256": "7fb02fc395ab3d3a7909ec22333e2519546986306818db8ea46571c0e76a16c7", "target": "Kaderin bu duvarların ötesinde bir yerde, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0010::Text::1", "source_sha256": "d7f6607df2cbb8165f91e65c09a361011f95ab4bbce64961f3035f43834551db", "target": "Yanımda her zaman yerin var, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0011::Text::1", "source_sha256": "1a4eab7714e7e123741f687de8fc18207de72d1c2ee72dcce8118c9e00c0fc7c", "target": "Umutsuzluğa kapılma, kararlılığını koru, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0012::Text::1", "source_sha256": "3673ffc6f57a27557d76199da893c3afcd1f76cfcb1db5feb16697ddbab14f38", "target": "Seni sevenler olduğunu unutma, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0013::Text::1", "source_sha256": "d38989500444a29bc488e29259210555f0acb9e1b04917e62931e6227ba018c3", "target": "Yaşadıklarının kararlılığını sarsmasına izin verme, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0014::Text::1", "source_sha256": "551bde01895dcd4e11333207a6c57a5392208c60ecbcdd451b619d8580e07f41", "target": "Beni görmeye geldiğin için teşekkür ederim, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0015::Text::1", "source_sha256": "7a4d2ef173611e6e3df75cbccede212637f62c229e3a13dbd6e0f4b56866db00", "target": "Böyle kısa konuşmalar beni sevindiriyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0016::Text::1", "source_sha256": "175d3897e0822448f2c137caee3f822b09b5eb2831d9a4c232af1a74941f6c7f", "target": "Baban her zamanki gibi, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0017::Text::1", "source_sha256": "469d17a2b8550df438fa6cae4c12d2659c8e6a13c36b2ded30213d104ebd1afd", "target": "Bir gün gönlündeki isteğe kavuşacaksın, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0018::Text::1", "source_sha256": "418c4bb10d04fb55681d73d4bcc21ae26949440d0dc3617656d5aa123fa57f85", "target": "Kader Tanrıçalarının sana ayırdığı hayat seni bekliyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0019::Text::1", "source_sha256": "9f58c24ae79e45e5c55bf96404c1f294d9a57788da92647664b2492177c7bf6d", "target": "Aradığını bulmanı dilerim, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0020::Text::1", "source_sha256": "968679a50567002dbde3bfadfbe3c5269857109266bc4a7871bea52a59e030fc", "target": "Burada kaldığın sürece seni koruyacağım, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0021::Text::1", "source_sha256": "3f6b098b979fe8263767b5a48712af4a1032d5298478b038a399e2b7068186b9", "target": "İyiyim, yine de beni düşündüğün için teşekkür ederim, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0022::Text::1", "source_sha256": "d5795f769e53bff9ac56c930b28e138bc5eaa4bf2ac6c63d1b837a519629cd57", "target": "Seni sapasağlam görmek beni çok sevindiriyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0023::Text::1", "source_sha256": "dd0de26be5d2f9467a080c942b2111bab23d2c2457d2f0d1af08e8a6741ea7d2", "target": "Yanımda olmandan her zaman memnunum, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0024::Text::1", "source_sha256": "7f121a7ab7fdcbe9b51d3f9a3f294574740303ff97afa4b98f706a1b6aad64b9", "target": "Beni görmeye gelmen çok ince bir davranış, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0025::Text::1", "source_sha256": "10f1536a607736897a49bb488dc8512206fe80dac35a74cde968f0975f0a159c", "target": "Bu kez epey iyi görünüyorsun, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0026::Text::1", "source_sha256": "4b33c41bd751cf282d938c8a4a9522dd38fd3fff96331c323452fbe05a429601", "target": "Bu kısa konuşmalar hoşuma gidiyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0027::Text::1", "source_sha256": "2a92ad90b80c63bbc7525690677aaf54619745092979c238c9794e786d0d0061", "target": "Sana inancım hiç sarsılmadı, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0058::Text::1", "source_sha256": "d8d5c576873aa4b1a5e08447471a8c7698e6b408604049dee599a87ca78b9245", "target": "Benim için kaygılandığını hissediyorum, evladım. Ama bu kaygını gidermek isterim."}
{"key": "Content/Subtitles/en/ZagreusHome.csv::ZagreusHome_0506::Line::1", "source_sha256": "fac35a6eced862bc12140f469a0483645ae48d53bac64b3478a37ab02a6c4526", "target": "Ben de, Nyx."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0059::Text::1", "source_sha256": "8883c60119927330b42b1324604b72b360de2ff55d0370971579da7d52cf24ed", "target": "Yolculukların seni başka yerlere götürse de seni görmek beni sevindiriyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0377::Text::1", "source_sha256": "05163ace624c464ad64510bfde7ec95086a3214348242b4c065ff64802df2142", "target": "Şu an başka konularla ilgileniyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0379::Text::1", "source_sha256": "cfa68dfb18f028871e80642070aeb6fcc7d76709395b3b7a4577be313bbaf390", "target": "Lütfen beni işimle baş başa bırak."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0380::Text::1", "source_sha256": "cf4be95642ff29ac2aadcc9c420cc2d1b42adf376ff18d42f2872466bef14c77", "target": "Başka bir zaman yine konuşalım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0032::Text::1", "source_sha256": "751350dd2044f3f73f402bb80db43f6ebbfa34c05fd2c25d8483d25264afed7e", "target": "Elimden geldiğince sana destek olacağım, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0348::Text::1", "source_sha256": "7b0f0eac4f7a32f6dcc5097870c61c6c1b79e2125af3ae56f5d23ffb42a5a878", "target": "Ne engelle karşılaşırsan karşılaş, yanımda her zaman yerin var, sevgili evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0349::Text::1", "source_sha256": "1a9564b1a444a77965e9b442b1c6259a401340f199bd3fd591597b9aadc895d7", "target": "Bu diyarın doğasını, evladım, burada veya yukarıda hiç kimse tam olarak bilmiyor, anlamıyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0350::Text::1", "source_sha256": "11b5f18462f9f66b594ab62cebdf5488fbd9d8b329c8b3773040b9902b8a67b0", "target": "Aşamayacağın bir engel yok."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0351::Text::1", "source_sha256": "e1567fa0c44932e2d7c89821cdad745d0f0b536ea173107c27cbb420f0853d7b", "target": "Şu an burada her şey yolunda, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0352::Text::1", "source_sha256": "5e5208bbdae7c3314407ce2903db6e78621b319fa9e8945f106dafab6a5b642f", "target": "Emeklerin sayesinde Konak sağlam duruyor, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0353::Text::1", "source_sha256": "00365bf5b2a77bcc842adbeb7d5c6f3947fd75d3ae43a9a09f16f535bd49efc5", "target": "Başarıların beni gururlandırıyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0354::Text::1", "source_sha256": "bdc80411698a9915b4c3d43c3f89bb0b11cb6b3a2c58e265d52a680adeb79ba6", "target": "Git, bu Konak’a hizmet et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0355::Text::1", "source_sha256": "3bbfc731199dde231fc227c410b7cfe3945c6da3d044544c7d4e86d68592ad40", "target": "Yolun Thanatos’la kesişirse sana yardım etmesini dilerim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0356::Text::1", "source_sha256": "401a0b3a96f2b4f3e0c82761e0a3109ef2ac08f6ad4c6da286126dc04704ca82", "target": "Gözlerden uzak kal, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0357::Text::1", "source_sha256": "798c8ab327dce91e0a6ab5a134c1915027e08741ecdfda955ee06f6c4b629a09", "target": "Kraliçe Persephone seninle çok gurur duyuyor olmalı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0358::Text::1", "source_sha256": "317f44317423686648e360eddc9466b5d277782c596760910a4f81be256ef88a", "target": "Git, seni doğuran anneni, Kraliçe’yi onurlandır."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0359::Text::1", "source_sha256": "bcdd2f2751e23e039bcef06ec502d9d933c141bc85f0d275276ea1b2a20682f3", "target": "Kraliçe’nin dönüşü bu Konak’ı güçlendirdi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0360::Text::1", "source_sha256": "157ef6b045eea3adf011b776d311c5d903322527f3db86f4105359ba1879d6b5", "target": "Kraliçe’yi onurlandır, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0361::Text::1", "source_sha256": "706bc6d99bce7ad445091ce615996c58bffe60ff469371afa35ef8ab2ade0959", "target": "Babanın keyfi son zamanlarda daha iyi."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0362::Text::1", "source_sha256": "968e54296099606ef709d194c3ffbbfa065cd67f83201f616faf437a6083b2b8", "target": "Seni doğuran annen bekliyor. Git, onu bul, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0363::Text::1", "source_sha256": "10333b5bf85f2ae03deadf27fdedb95ea6c49ef036e11eab23fdbdabbe96d489", "target": "Seni doğuran annenin yanına yeniden git, evladım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0364::Text::1", "source_sha256": "aa090b24d61e53ab9ba9e4db3663ff226a4a43f980543a8fb7950072c0dfc96b", "target": "Persephone yukarıda bekliyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0365::Text::1", "source_sha256": "85ab628bc7f600ce9efd2808e57ce92a82d010a803eef20cec13227057a36066", "target": "Seni doğuran annenin seni beklediğini kesin olarak biliyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0366::Text::1", "source_sha256": "26e0a1faea4547927a6f6fd35703d87ab0fa8bbf60f78987615fe88eb17a8081", "target": "Git. Artık onu nerede bulacağını çok iyi biliyorsun."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0372::Text::1", "source_sha256": "237a8b04cc34b6ba79c5a01f61d2db42caf1a4def08c5c4beab19cff3a474cca", "target": "Korkarım şu an sana yardım edemem."}
{"key": "Content/Scripts/NPCData.lua::/VO/Nyx_0373::Text::1", "source_sha256": "68c96d5723c10635dc0e6aa46a890ace2f51b8761b1b38e008adc32ae921b0a1", "target": "Zamanı geldiğinde aradığını bulacaksın."}
