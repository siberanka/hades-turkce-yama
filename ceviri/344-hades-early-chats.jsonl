{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0124::Text::1", "source_sha256": "c2cbdeebd22c1a20977cab39ea2f7cc38a0d063da14d5f05e9ebf623ca0660e7", "target": "Söylemek istediğin her neyse, duymak istemiyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0124::Text::2", "source_sha256": "c2cbdeebd22c1a20977cab39ea2f7cc38a0d063da14d5f05e9ebf623ca0660e7", "target": "Söylemek istediğin her neyse, duymak istemiyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0125::Text::1", "source_sha256": "933455c4ba8989d2adb8e30ddddf28832f280925fdc1ddb8e1efa0db06442278", "target": "Çalışırken beni bölüyorsun."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0126::Text::1", "source_sha256": "bb7c90bb8d8515dafff5f8219f31ed61059c273ee54b410546a2d1b540effd7e", "target": "Son zamanlarda seni fazlasıyla dinledim sanırım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0127::Text::1", "source_sha256": "9b41388677514c96ef6b46561968aff265f49b8631115e13bda59ded7ecc0045", "target": "Vaktimi bilerek boşa harcıyorsun, değil mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0128::Text::1", "source_sha256": "a8be12b44487691e07fb2cd60d519f957e000f58d32cc42f3a34e49be2b5fe83", "target": "Git, çık dışarı. Seni tutmayayım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0129::Text::1", "source_sha256": "13e18b50f727b03bebb6d710a484e02ca0a9207a033dc1229a65b747cfc479e8", "target": "Ölülere kendini şişletmen gerekmiyor mu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0130::Text::1", "source_sha256": "0d76f542fc571ffcd8ca66df70c60916d5fb79ebbd6adde6f43f881a9d0d01ec", "target": "Odana git. Ya da burası dışında herhangi bir yere."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0131::Text::1", "source_sha256": "dbbdc16d91556480a3dcc26d94f21605d8a3063445faedfe8d84f2e2d1eb72e8", "target": "Kan ve karanlık, senin derdin ne?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0132::Text::1", "source_sha256": "b1cdcec6f42a21000dbff79ba11372c2f641e2e025092b17a0820f8c074c6e22", "target": "Bana söyleyecek daha fazla küstah laf mı buldun?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0133::Text::1", "source_sha256": "0b8432b07defb5fd63449cd2c2dd6dc258dcf31135a8e6c130d47d021abd82f5", "target": "Senin saygısızlığınla uğraşmayacağım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0134::Text::1", "source_sha256": "8c3eb65376d50d9dc209eb0bb476a9ec298a23d6e76047b5ca6c6f0756985b37", "target": "Meşgul olduğum hiç aklına geldi mi?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Hades_0135::Text::1", "source_sha256": "bba8d6c96b6368540511eef1a300ad56dbe84f536662a113aa22fe1e0108fe64", "target": "Seninle sohbet etmek istemiyorum, evlat."}
