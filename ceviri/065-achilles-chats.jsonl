{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0017::Text::1", "source_sha256": "9a86fe34277cc45a376890cf648a018fd57de3db867c8618f043093e0e7d91b5", "target": "Talimde öğrendiklerini hatırla, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0018::Text::1", "source_sha256": "c02f5640abaecc31cc9be84667d21bcd30131017d772b32607d7935f2a6c17b3", "target": "Bunu başarabileceğinden zerre kuşkum yok."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0019::Text::1", "source_sha256": "0c3bfa439c4b8efcf0df85c4a28bab87d5ef3354987e05e03ffc72e9ee8f483f", "target": "Yola çık, delikanlı. Yapman gerekeni yap."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0020::Text::1", "source_sha256": "cb6cd7f9d423fdec3f1b7c963a681c6acaab16626ad34e75b940692ba606014f", "target": "Sen yokken buraya göz kulak olurum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0021::Text::1", "source_sha256": "8af483f4922470a6f5847aad2c7559168de0fb3fa18a26d192ecd45dbe9093f0", "target": "Gereğinden fazla oyalanma, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0022::Text::1", "source_sha256": "e37d1a2467999ef4fa07e9e4a21e0bd521b7dc302d574d9121538bea6bfa4837", "target": "Sana öğretecek bir şeyim kalmadı, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0023::Text::1", "source_sha256": "c2fe65bf54ee25ceaf20109c4ab1ab8ac40f171d3cd101beb675f009f60758b9", "target": "Tek bir canın varmış gibi dövüş."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0024::Text::1", "source_sha256": "89e66d82523c838642d65394420f911237fbab837306148101ea48040f061edf", "target": "Dışarıda benim dövüşeceğim gibi dövüş."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0025::Text::1", "source_sha256": "4f23b8a385a091673ce495384670295c11a63d9b0d10001ea32fddaabcd04439", "target": "Elinden geliyorsa hemen dönme, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0026::Text::1", "source_sha256": "af87be5ad212aeef83abaebe15eecce46e10bd675200c4d5a7941ab9c8f15e2d", "target": "Dışarıda içgüdülerine güven."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0027::Text::1", "source_sha256": "ec761a828ca9562da0eac13604a3a1ba5516acf0953324ae8412ad909ec99871", "target": "Konak güvende, delikanlı. Git."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0028::Text::1", "source_sha256": "2abc60174c600b12ebd21aa51d98a93d64acf31138336f521f2126d4375f80bb", "target": "En iyi öğretmen tecrübedir, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0029::Text::1", "source_sha256": "f7f5eb0dda7b154fefd72fa5712954da4a1a5f63b37ff52da7137739374a91ba", "target": "Yeniden çık ve başladığın işi bitir, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0030::Text::1", "source_sha256": "7c50b24c597b11465c5b079cdf3a66cd8107b20648f01d60eaed21490ca403c6", "target": "Nyx’le burada her şeyi kontrol altında tutuyoruz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0031::Text::1", "source_sha256": "d2270d29e138061c5f69d9c5ca0f87657287e8944d9bb35a9de2c20871fef73e", "target": "Hatalar da öğrenmek için fırsattır, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0032::Text::1", "source_sha256": "8850e999c5212101a48ceeda37a986d8a460b8e849c37a23e42ed86b03a36175", "target": "Odana git, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0033::Text::1", "source_sha256": "cf2b2730589af6837ac1ead575ceecbf1fb332cd1e6b8b5c24d53143b3c7f098", "target": "Ne olursa olsun arkandayım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0034::Text::1", "source_sha256": "bfe0f426ecc9fe5259f598effda117d04bb6c707f1fc1a9881b5826030bad001", "target": "Hazırlan, delikanlı. Bir daha dene."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0035::Text::1", "source_sha256": "46d344d617ec1d78a628bf08069f62bfbd9594572e83aa9727b56e8ebb16d100", "target": "İkinci sınıf tanrı diye bir şey yok, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0036::Text::1", "source_sha256": "aa5a362ad0b6769173fa2ba7c0ae3c05ab55ba0cfcf76fbbeb9859b9122194eb", "target": "Yapabileceğim bir şey olursa söylemen yeter."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0037::Text::1", "source_sha256": "16e75a555e0aa75961bbcfef6e92f2210351ff712251160fa6bbd6fd36e81c67", "target": "Başaramayacağın bir şey yok. Bundan eminim."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0038::Text::1", "source_sha256": "5a8269fc01c36d0d14c9ec6d35ad7696a7686c5a72c206c60865b572dd70f64f", "target": "Hayatını benim yaptığım gibi harcama, delikanlı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0039::Text::1", "source_sha256": "d8b0042a9b1c31b4e521a77941d4c9e58bfdf8fe07e8b4002c369cf0046b364f", "target": "Uğruna dövüşmeye değer bir şey bulduğunu bilmek beni sevindiriyor."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0040::Text::1", "source_sha256": "b8b28e7055eb2375517a10703310b2ec607f06f45c94a980193975c6dbdec23f", "target": "Başaracaksın, delikanlı. Lanet olsun Kader Tanrıçalarına."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0041::Text::1", "source_sha256": "8f3ac5697959d435dc452338baf0c5d4da7fd2922216d086bd73152b96f1e7d7", "target": "İyi bir kalbin var, delikanlı. Onu dinlemeye devam et."}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0184::Text::1", "source_sha256": "4e29628546fed5c9d12673afaf8581e26d6b3cd43739ec68072007af51296144", "target": "Buradaki Ruh bana meşhur bir savaşı anlatıyordu."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0355::Text::1", "source_sha256": "c8293bb2fd78a86b79ecebad47a1396dd3f958920769840864befbc5484da06c", "target": "Ne yazık ki hikâyelerimin çoğu, bir sebepten, kan dökmekle ilgili..."}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0185::Text::1", "source_sha256": "fd5e8868062be740965c4ff1b179c1d95358dc3058f6227e7c612a384e521f83", "target": "...Mızrak doğru ellerde işe yarar ama kırbacı durduramaz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0356::Text::1", "source_sha256": "0c6f635b7e77eadb79a48545f7bcca0db3ac42fe87145abe7db4046f3bb37026", "target": "İtiraf etmeliyim, Hanımefendi, sözünüzü çürütecek kadar tecrübem yok böyle bir silaha karşı. Neyse ki."}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0186::Text::1", "source_sha256": "91770d6085f400cf0bb2d4e37b22497ce38b92406e5171421c0d66e81ec2f470", "target": "...Elindeki şişe bitince bir tane daha doldur, Ruh."}
{"key": "Content/Scripts/NPCData.lua::/VO/Achilles_0357::Text::1", "source_sha256": "274c5f3396a096cd21c7de640b5368aa17f3f7c7eb54b3675476ae88952ecdfe", "target": "Emredersiniz, Hanımefendi! Kusurumuza bakma, delikanlı."}
