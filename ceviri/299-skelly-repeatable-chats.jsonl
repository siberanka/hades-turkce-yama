{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0026::Text::1", "source_sha256": "6dad985a061157528641953047c8ddb7bb5065827be1b3bb4e499963602a09aa", "target": "Az laf, bol tokat, evlat! Hadi!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0027::Text::1", "source_sha256": "601e4a3f02c2c6d63cbb4a89d32de1a4a4294bfa766399f8c37818c3676c3747", "target": "Az konuş, çok döv, evlat! Vur bana artık!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0028::Text::1", "source_sha256": "bfb22a708f6c836963690bbf8b25fa39350de36111a79a744d6013e51ca0d5b2", "target": "Az muhabbet, bol yumruk, dostum!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0029::Text::1", "source_sha256": "6f60c6d063c7391bcddcb4d6070e3dd7d224bda538047753b519ea99ba27f162", "target": "Hadi evlat, az konuş, çok sapla!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0030::Text::1", "source_sha256": "707c7227d4d8bf94e0fd7e80a06a20adf9df76f92776e6d8080b93eea2e10c8e", "target": "Az gevezelik, bol dövüş, evlat! Var gücünle vur!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0031::Text::1", "source_sha256": "32bd058e39c7ff2df3bb76f6b3e209b4a10e1a81bc17f230628d764e569482c7", "target": "{#DialogueItalicFormat}Bu {#PreviousFormat}kemikleri kıramazsın, dostum! Dene de gör!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0032::Text::1", "source_sha256": "008b86ea6ff0a986f4e0fcb2f5c01a59fe1533214b501e88cbb29b5c3f2f622f", "target": "Bir tur daha mı istiyorsun, ha?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0033::Text::1", "source_sha256": "6d34fbdde09981df26d8a27d34d5bafd09b8f0c634e3c113ddb9851cef5d8732", "target": "Bu kadar muhabbet yeter, evlat! Hadi, vur bana!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0034::Text::1", "source_sha256": "2eb9c6f780e68330992b51372e3a3f011e786d71a51eee1ff2bacd4b75a6177d", "target": "Bunca muhabbetle beni sıkıntıdan öldürmeye mi çalışıyorsun, dostum?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0035::Text::1", "source_sha256": "1f00e1a77dae2f40339c64f521b893e6f96b244bc720b7c904984fa4b35e9cfb", "target": "Ben sana dert ortağı gibi mi görünüyorum, evlat?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0036::Text::1", "source_sha256": "13c70e072c431777cfa987abfa71fa7944fa04b5b4726743a9aaf7251c910920", "target": "Vur bana artık, evlat! Kendini tutma!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0037::Text::1", "source_sha256": "add983229e3798e1e2e6c6b322ce7b46af108cbb9760d325366751a8879d8b85", "target": "Bakalım bana vururken neler yapabiliyorsun, dostum!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0038::Text::1", "source_sha256": "455359b313fafbd7f541b37d42c0e54c4837c18257f9ad95f4dcc7396f837589", "target": "Şu an bana vuruyor olabilirdin, evlat!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0039::Text::1", "source_sha256": "7e5eaf0f8af31e4df1b2dc101b62f03a280d5b4d1d60895217889ebf59e16e4e", "target": "Şu an biri beni güzelce pataklasa hiç fena olmazdı."}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0040::Text::1", "source_sha256": "e6d64f48ce5c2958f9b9eeae1400fbca3de74eee31420d77cbcd1f86843a9e0f", "target": "Ne oldu, dostum, yumuşadın mı yoksa?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0041::Text::1", "source_sha256": "538d20558fa51ec477faeb66b05582aa34dc1ca12daaf47497a6c31a73ce1e4a", "target": "Bana vuracak mısın, ne yapacaksın?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0042::Text::1", "source_sha256": "1c59de68758b86e97b51a3263b3fe30188b5bb5c06e246d8d4ac6799fbf84eb9", "target": "Hadi, evlat, en sağlam darbeni indir! İşim bu!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0043::Text::1", "source_sha256": "893e2de0b14bdcd227fdfcb58addc0250c7c70018a7036bb31a0742d5b91f7f6", "target": "Şu an çeneme sağlam bir tane geçirsen çok iyi olur!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0044::Text::1", "source_sha256": "c7f6498b9aad088662ce9738de4970aae2738749d01eaada02177ac164dc04e3", "target": "Dövüşmek mi istiyorsun, evlat? O zaman hemen başla!"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0045::Text::1", "source_sha256": "995c7c1c0c820b296865edd9041e5870840251916cf592919419b28ea2ce06ac", "target": "Ben sana sohbet arkadaşı gibi mi görünüyorum, dostum?"}
{"key": "Content/Scripts/EnemyData.lua::/VO/Skelly_0046::Text::1", "source_sha256": "026f0baadf01477fe59bb9b66160fc8c5d561bf4aeb749afeee553a232888269", "target": "Bizim ilişkimizde lafa gerek yok, evlat!"}
