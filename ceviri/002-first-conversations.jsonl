{"key": "Content/Subtitles/en/Achilles.csv::Achilles_0184::Line::1", "source_sha256": "6aa76904a6ef92f623b077e6c5ee09d052790158764d9901c4183d9c740d1db5", "target": "İçeri girsen iyi olur, delikanlı..."}
{"key": "Content/Subtitles/en/Achilles.csv::Achilles_0187::Line::1", "source_sha256": "10e19e367a167c57f91a0684a507c126663e0749a0e6f85d6886efed25d789f8", "target": "Seni oraya alamam, delikanlı."}
