{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0381::Text::1", "source_sha256": "7d0e26072c7883e12783911af05f7791c3c102ec3c6b315c31c10a0e81e88a60", "target": "Konuştuğumuzu görmüyor musun, Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0382::Text::1", "source_sha256": "43421a5cf71834e4cbe81b1243431edebefa50e5822de50c4bc97556bf72d5b8", "target": "Müsaadenle Zagreus, bir görüşmedeyiz."}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0385::Text::1", "source_sha256": "94472ff8560b9e23cd5cd9eb593258c8e0d355e7f5c46dcdcd68df13667c7e73", "target": "Bizi bölmesen de olur, biliyorsun değil mi Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0386::Text::1", "source_sha256": "000f7041b380036a72ac3d1712e776a0cc40c0905558e6511a57f2ff50474f03", "target": "Bu konuşma seni ilgilendirmiyor, Zag."}
{"key": "Content/Scripts/NPCData.lua::/VO/MegaeraHome_0387::Text::1", "source_sha256": "d53fd14aaf5f56e2fe8b2d3b578334efa8d6c3ef19f802e3ce40f9d9f2d30482", "target": "...Ama bazen Dusa, lafın nereye gittiğini pek anlamıyor..."}
