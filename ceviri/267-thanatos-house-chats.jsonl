{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0002::Text::1", "source_sha256": "7602664c9f3f9804d4a11d361e995a4bcdf0392d2155e5a0f1884246fc2adf05", "target": "Kusura bakma, Zagreus, gitmem gerek. Son zamanlarda çok iş var. Keşke her yerde aynı anda bulunabilsem."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0003::Text::1", "source_sha256": "cb8a0a7237ec622dd5ff1bf31515d05a081aa7704ce36e162d99d31a733892e7", "target": "Boş sohbetin bir yararı yok, değil mi, Zagreus?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0004::Text::1", "source_sha256": "dda90f8d61880f23fe214114fe7607a769a53233544323beff732b9e80fabc7a", "target": "Benim yapacak işim var, senin de burada kalmaya niyetin yok. Dışarıda görüşürüz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0005::Text::1", "source_sha256": "e82677b472de6068f7c905d8f8e72583cfc77123619151db85c271321bd98699", "target": "Hiç uğraşma, Zagreus. Ben de gidiyordum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0006::Text::1", "source_sha256": "08b5b5694e4b5221321491dd437cc4c5d8bf05fd71625fdc94fc46fd8293ea56", "target": "Umarım bütün bunları iyice düşünmüşsündür. İkimizin de iyiliği için."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0007::Text::1", "source_sha256": "fb15c3a6e3485057d1ed37a738ff60a43ad5995573ad4883d4b17bf72d5f520c", "target": "Boyunu aşan işlere her giriştiğinde seni kurtarıp duramam."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0008::Text::1", "source_sha256": "7bb9c11e0fbfd599d0ce8b17aa0dd11787af586913c5d14a9f35b4f18895472d", "target": "Kendini epey belaya soktuğunu söylemeliyim, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0009::Text::1", "source_sha256": "23e5cbda79f06c4091982ac8ead95d2881b886dc97db0d57cd814d8cb3e66623", "target": "Ne yaptığını biliyor olman gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0010::Text::1", "source_sha256": "dfa87acf3a5d795d90bb8687afc466e72fda31c5e0a018e9d3edb68e70cdfc62", "target": "Vaktini boşa harcıyorsun. Git artık."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0011::Text::1", "source_sha256": "c1450c0c6afa5bdcf6338dafc82138dab1aafe0a5fa8a40441aa686a55d60613", "target": "Çoktan dışarıda kendini öldürtüyor olman gerekmiyor muydu?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0012::Text::1", "source_sha256": "34c52d49e745c97564c38bdd30fe2c85a890085d9f31089360fb507b1bd0a612", "target": "Burada kendimi ne kadar belaya soktuğumu biliyor musun?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0013::Text::1", "source_sha256": "9060149bbe647090424f6c7aa052c8aeeea3c6246a04a4ebea5cf01439ac05a0", "target": "Konuşacak bir şeyimiz kalmadı."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0014::Text::1", "source_sha256": "50aebdc9309b786859d4dadef2d1806265830cf75a0e507419e3bf2b10329a31", "target": "Benimle konuşma. Git artık."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0015::Text::1", "source_sha256": "b6afed6d9608514fca7e5cfe189693089fb9b0ddce38a6ed99a0c94d7a7d804f", "target": "Müsaade et, yapacak işim var."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0016::Text::1", "source_sha256": "230d5752257fc35a366612353074890389bd6c8d4585702f1f216e6fea4c7913", "target": "Şimdi olmaz, gitmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0017::Text::1", "source_sha256": "8829d73b0eeadf54cff78f10d7f5aec29707e02504ad6db6082bca8b14e8f4bc", "target": "Benden ne istediğini bilmiyorum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0018::Text::1", "source_sha256": "8f6bb48ac713f63d0d1fc57a2ba25f16df9d38a1488390e928e2899f5cbbe6f9", "target": "Görevlerime dönmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0019::Text::1", "source_sha256": "4a189fd2594f3361b2ecf9a76e18d3fa97d79a8917c5bc6bbad99b6dd90d51fa", "target": "Başın çok büyük belada."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0020::Text::1", "source_sha256": "7ba5df509453a9a914b1816510a50a8d6bcab61823cf7b804c6917f7da73f4f7", "target": "Dışarıda kendine dikkat et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0021::Text::1", "source_sha256": "e55540967820465c15341526f32d3a912da11ab93c0a478388e9dafb1f660cd1", "target": "Kendine dikkat et."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0022::Text::1", "source_sha256": "6c5ed2bdf43f00d33963c0fb9c1b3f713b55c488383f54a2813d949c90489888", "target": "Dışarıda görüşürüz, sanırım."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0023::Text::1", "source_sha256": "edbd00666bc5352e55799bad3cd9dd2301afa443f46f89596b1571a769ec1feb", "target": "Umarım bütün bunlara değer."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0024::Text::1", "source_sha256": "b002773e6c33c7e9c9327de3d475ce4357e03d176b24be9e2c64c5b5885cad05", "target": "Dışarıda yine karşılaşacağız."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0025::Text::1", "source_sha256": "c1c03687696bf609462f68b833d2073c6150153d8bd771d7d8b39dd9053dee30", "target": "Umarım ne yaptığını biliyorsundur."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0026::Text::1", "source_sha256": "2a119e26b6cd3418ff6f961585215ed1b60a291226ce6c0848d993a2b05cf467", "target": "Şu anda konuşamam, işe dönmem gerek."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0027::Text::1", "source_sha256": "f3c24d50451b8458fbfdf01869b7355734c916341fd74e332ad896a4d7299e9f", "target": "İşe dönmem gerek. Sonra görüşürüz."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0028::Text::1", "source_sha256": "38bd0655b6283bc6e7eec5a1c1a613a8c060cd4d7525710fe4148827f7c52eed", "target": "Baban başımı yakacak."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0029::Text::1", "source_sha256": "52e01569ab6da6c90ce931e951191b0195aa7a5b266b3b160ad1b093adcfbc7c", "target": "Başım öyle büyük belada ki, haberin yok..."}
{"key": "Content/Scripts/NPCData.lua::/VO/Thanatos_0030::Text::1", "source_sha256": "bebc829468b3ca7f74e8c449bf57c61a56e0b670efdbc0a2b34f4bb641e40be0", "target": "Kendimi neye bulaştırdım ben, Zag..."}
