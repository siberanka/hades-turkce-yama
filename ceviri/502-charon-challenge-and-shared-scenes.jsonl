{"key": "Content/Subtitles/en/ZagreusField.csv::ZagreusField_3749::Line::1", "source_sha256": "2e2536eb557dc69b76be71ad5f44bfa5fb9cafc237aa87010953e9d1a4a79644", "target": "Ha. Beni öldüreceğin içinmiş."}
