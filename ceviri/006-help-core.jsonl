{"key": "Content/Game/Text/en/HelpText.en.sjson::StackUpgrade_FlavorText03::DisplayName::1", "source_sha256": "3b8e6c5108f9682120fffbca5d8a113679a6b0b4a6bd02ebb2749f958cb0df9e", "target": "yeraltı narının taneleri, görünüşlerinden beklenmeyecek ilahi bir güç barındırır."}
{"key": "Content/Game/Text/en/HelpText.en.sjson::WeaponUpgrade_FlavorText01::DisplayName::1", "source_sha256": "5ac975ecd4a85a2047d55b87d30a80a50a84d7cfd0e5c8944d55ab6a6bae1748", "target": "usta zanaatkâr, hades için yaptığı uğursuz işi tamamlayınca aletlerini bir kenara attı."}
