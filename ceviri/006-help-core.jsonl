{"key": "Content/Game/Text/en/HelpText.en.sjson::DionysusUpgrade_FlavorText03::DisplayName::1", "source_sha256": "49cbd14e265c00c12d6f41324e2f2c7b555841e6339b3b8c3f280858b89168eb", "target": "insanlık, berrak düşüncelerinden ve keskin duyularından kurtulmak için ne çok uğraşır."}
{"key": "Content/Game/Text/en/HelpText.en.sjson::HermesUpgrade_FlavorText01::DisplayName::1", "source_sha256": "4883c9977a6de7f7dcf79fa22083c4667fa7db3cd6a03e81af2941f175c70cef", "target": "hiçbir ölümlü, tanrıların habercisinin olağanüstü hızına yaklaşamadı."}
