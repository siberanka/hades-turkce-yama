{"key": "Content/Game/Text/en/HelpText.en.sjson::DemeterUpgrade_FlavorText03::DisplayName::1", "source_sha256": "be08ffe242fa3f0bc3872e515f5930d54dca5a35f8dc399fca94ccd4c5c46089", "target": "olimposluların en yaşlısı, gökle yer arasındaki her şeye hükmeder."}
