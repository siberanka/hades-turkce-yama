{"key": "Content/Game/Text/en/HelpText.en.sjson::WeaponUpgrade_FlavorText03::DisplayName::1", "source_sha256": "010c07a4513b4ca120b1b85aad69bad7da40ac50af13ea7dbb6ab97670d88eed", "target": "ondan sonra binlerce yıl boyunca, yeryüzünde kimse onun yeteneğine erişemeyecekti."}
{"key": "Content/Game/Text/en/HelpText.en.sjson::DionysusUpgrade_FlavorText01::DisplayName::1", "source_sha256": "2de5acef5bfc714f1f02a61cd31d7ee2d417bfe08af79c8369820b1e22d01ac5", "target": "meğer hayatın basit zevkleri de insana hükmedebiliyormuş."}
