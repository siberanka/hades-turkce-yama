{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0003::Text::1", "source_sha256": "2f57c69c92d425980749c9601e1b13dff21462152dcbcb499e997f250e638aa9", "target": "Üzgünüm, Zagreus. Şarkı söylemeye hiç isteğim yok."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0004::Text::1", "source_sha256": "02a4f55d8a6455d0f231c47e94039c6e8268112ca02f5e0a7e707c27210daf0d", "target": "Şarkı söylemeyi reddetmek zorunda kalınca biraz mahcup oluyorum...!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0005::Text::1", "source_sha256": "8f433dc2cd771f53e428371ddee324df62dedb576cf6d4e69df18bd77260e292", "target": "Hâlâ mütevazı saray müzisyeninim, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0006::Text::1", "source_sha256": "bb979b9198ac23a58bd778d655e75a1cbe652af8105cd7df9e443ab879ce10b7", "target": "Seni gördüğüme gerçekten sevindim, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0007::Text::1", "source_sha256": "6e74196bbf6f55ae3861a564aaa63cac1a08f569bb672284ac5a073071c46747", "target": "Keşke sana bir şekilde yardım edebilsem, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0008::Text::1", "source_sha256": "43c1c21c512a78bedef689d8a40052a065d7fb93af4527df82baf5ddf3e7886e", "target": "Sen yokken ortalık korkunç sessiz. Şimdi de epey sessiz gerçi!"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0009::Text::1", "source_sha256": "bc456551248738345cd114ac17e75e796dfbeb64b4e7d865aec109e524b89148", "target": "Seninle konuşmak güzel, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0010::Text::1", "source_sha256": "2dba20fd5b190c64a76c62e1158174aee6f5e86f0714b10a3bff9c2a0dfa39ea", "target": "Korkarım bu sefer söyleyecek pek bir şeyim yok, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0011::Text::1", "source_sha256": "26551f818e7a3b606c687ba8be09078e8a634ae1837b5bbbec2d3295a3e5ea67", "target": "Umarım günün güzel geçiyordur, Zagreus. Ya da gecen, artık hangisiyse."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0012::Text::1", "source_sha256": "e231591c1f94859e11e73a38ee5d6091b08b8558f7ebe211de45777be81a6fad", "target": "Orada dikkatli ol, lütfen, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0013::Text::1", "source_sha256": "59689a94ce9117e7996d2e0e253869ec71ce6d9b91ccf90f85676d689c5e5dfb", "target": "Keşke seni çok daha canlı bir saray müzisyenine yönlendirebilsem."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0014::Text::1", "source_sha256": "6cf820967148af96c630ba1bbedd0f4cafabaca8fb249d37b92ebdc9fa37b72c", "target": "Normalde böyle durumlarda bir şarkı söylerdim, Zagreus."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0015::Text::1", "source_sha256": "41d2b9ef8226e685b73f20e68e93342c9fa4ac32130220e5827b82f927ef6e41", "target": "Orada güçlü ol, dostum, tamam mı?"}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0016::Text::1", "source_sha256": "a906430e549c8c0e6031e6a482d2761c2642ec8c305ec84f4b245cd2020b788e", "target": "Sonuna kadar senin yanındayım, dostum."}
{"key": "Content/Scripts/NPCData.lua::/VO/Orpheus_0017::Text::1", "source_sha256": "b9ef35a13ff714decad6594042a05ba70c68d7626ada35f912559ac7c790a4cc", "target": "O ölümcül cehennemde sana bol şans, Zagreus."}
